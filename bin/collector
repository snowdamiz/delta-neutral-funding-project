#!/usr/bin/env bash
set -euo pipefail

base_url=${COLLECTOR_URL:-http://127.0.0.1:8080}
project_dir=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)

usage() {
  printf '%s\n' \
    'usage: collector <command> [arguments]' \
    'read: status | capabilities | adapter-status | portfolios | opportunities | pnl | compare' \
    'control: pause-entries <reason> | pause-all <reason> | resume <reason> | reconcile <reason>' \
    'paper: exit <portfolio> <reason> --approve-paper | flatten <reason> --approve-paper' \
    'replay: replay --bundle <path> --config <path>' \
    'test: alerts-test <reason>'
}

read_endpoint() {
  curl -fsS "$base_url$1" | jq .
}

mutate() {
  local action=$1
  local path=$2
  local reason=$3
  local secret=${OPERATOR_HMAC_SECRET:?OPERATOR_HMAC_SECRET is required}
  local key body signature
  key="cli-$(date +%s)-$$-${action}"
  body=$(jq -cn --arg reason "$reason" '{reason:$reason}')
  signature=$(
    printf '%s\n%s' "$key" "$body" |
      openssl dgst -sha256 -hmac "$secret" -hex |
      awk '{print $NF}'
  )
  curl -fsS \
    -H 'content-type: application/json' \
    -H "x-idempotency-key: $key" \
    -H "x-operator-signature: $signature" \
    --data "$body" \
    "$base_url$path" |
    jq .
}

require_reason() {
  test -n "${1:-}" || {
    usage >&2
    exit 2
  }
}

absolute_file() {
  local path=$1
  test -f "$path" || {
    printf 'file not found: %s\n' "$path" >&2
    exit 2
  }
  printf '%s/%s\n' \
    "$(CDPATH='' cd -- "$(dirname "$path")" && pwd)" \
    "$(basename "$path")"
}

command=${1:-}
case "$command" in
  status) read_endpoint /v1/status ;;
  capabilities) read_endpoint /v1/capabilities ;;
  adapter-status) read_endpoint /v1/adapter/status ;;
  portfolios) read_endpoint /v1/portfolios ;;
  opportunities) read_endpoint /v1/opportunities ;;
  pnl) read_endpoint /v1/pnl ;;
  compare) read_endpoint /v1/pnl/comparison ;;
  pause-entries | pause-all | resume | reconcile)
    require_reason "${2:-}"
    mutate "$command" "/v1/$command" "$2"
    ;;
  exit)
    test "${4:-}" = '--approve-paper' || {
      printf 'paper exit requires --approve-paper\n' >&2
      exit 2
    }
    require_reason "${3:-}"
    case "${2:-}" in
      sol-control) portfolio=local-sol-control ;;
      jitosol-carry) portfolio=local-jitosol-carry ;;
      sync-sol-control) portfolio=local-sync-sol-control ;;
      sync-jitosol-carry) portfolio=local-sync-jitosol-carry ;;
      local-sol-control | local-jitosol-carry | local-sync-sol-control | local-sync-jitosol-carry)
        portfolio=$2
        ;;
      *)
        printf 'unknown paper portfolio\n' >&2
        exit 2
        ;;
    esac
    mutate exit "/v1/portfolios/$portfolio/exit" "$3"
    ;;
  flatten)
    test "${3:-}" = '--approve-paper' || {
      printf 'paper flatten requires --approve-paper\n' >&2
      exit 2
    }
    require_reason "${2:-}"
    mutate flatten /v1/emergency-flatten "$2"
    ;;
  alerts-test)
    require_reason "${2:-}"
    mutate alerts-test /v1/alerts/test "$2"
    ;;
  replay)
    test "${2:-}" = '--bundle' && test "${4:-}" = '--config' && test -z "${6:-}" || {
      usage >&2
      exit 2
    }
    bundle_path=$(absolute_file "${3:-}")
    config_path=$(absolute_file "${5:-}")
    image=$(docker compose \
      --project-directory "$project_dir" \
      --file "$project_dir/compose.yaml" \
      config --format json |
      jq -er '.services.collector.image')
    docker image inspect "$image" >/dev/null 2>&1 || {
      printf 'collector image is missing; run docker compose build collector\n' >&2
      exit 2
    }
    docker run --rm \
      --network none \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --volume "$bundle_path:/replay/bundle.jsonl:ro" \
      --volume "$config_path:/replay/config.json:ro" \
      "$image" replay \
      --bundle /replay/bundle.jsonl \
      --config /replay/config.json |
      jq .
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
