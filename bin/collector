#!/usr/bin/env bash
set -euo pipefail

base_url=${COLLECTOR_URL:-http://127.0.0.1:8080}
project_dir=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)

usage() {
  printf '%s\n' \
    'usage: collector <command> [arguments]' \
    'read: status | capabilities | adapter-status | portfolios | opportunities | pnl | compare | solana-wallet-flow' \
    'control: pause-entries <reason> | pause-all <reason> | resume <reason> | reconcile <reason>' \
    'paper: flatten <reason> --approve-paper | paper-reset --initial-usdc <usd> --initial-collateral <usd> --approve-paper-reset' \
    'validation: solana-validation-start <request.json> | solana-validation-evidence <evidence.json>' \
    'replay: replay --bundle <path> --config <path>' \
    'proof: solana-read | solana-subscribe | solana-inspect-instruction | solana-inspect-jupiter-build | solana-transaction-proof | solana-transaction-burst' \
    'test: alerts-test <reason> | verify-toolchain'
}

read_endpoint() {
  curl -fsS "$base_url$1" | jq .
}

signed_post() {
  local action=$1
  local path=$2
  local body=$3
  local secret=${OPERATOR_HMAC_SECRET:?OPERATOR_HMAC_SECRET is required}
  local key signature
  key="cli-$(date +%s)-$$-${action}"
  signature=$(
    printf '%s\n%s' "$key" "$body" |
      openssl dgst -sha256 -hmac "$secret" -hex |
      awk '{print $NF}'
  )
  curl -fsS \
    -H 'content-type: application/json' \
    -H "x-idempotency-key: $key" \
    -H "x-operator-signature: $signature" \
    --data "$body" \
    "$base_url$path" |
    jq .
}

mutate() {
  local action=$1
  local path=$2
  local reason=$3
  local body
  body=$(jq -cn --arg reason "$reason" '{reason:$reason}')
  signed_post "$action" "$path" "$body"
}

require_reason() {
  test -n "${1:-}" || {
    usage >&2
    exit 2
  }
}

usd_to_micros() {
  local usd=$1
  case "$usd" in
    '' | *[!0-9]* | 0)
      printf 'USD amount must be a positive whole number\n' >&2
      return 2
      ;;
  esac
  test "${#usd}" -le 9 || {
    printf 'USD amount is too large\n' >&2
    return 2
  }
  printf '%s\n' "$((10#$usd * 1000000))"
}

absolute_file() {
  local path=$1
  test -f "$path" || {
    printf 'file not found: %s\n' "$path" >&2
    exit 2
  }
  printf '%s/%s\n' \
    "$(CDPATH='' cd -- "$(dirname "$path")" && pwd)" \
    "$(basename "$path")"
}

collector_image() {
  local image
  image=${COLLECTOR_IMAGE:-}
  if [ -z "$image" ]; then
    image=$(docker compose \
      --project-directory "$project_dir" \
      --file "$project_dir/compose.yaml" \
      config --format json |
      jq -er '.services.collector.image')
  fi
  docker image inspect "$image" >/dev/null 2>&1 || {
    printf 'collector image is missing; run docker compose build collector\n' >&2
    return 2
  }
  printf '%s\n' "$image"
}

command=${1:-}
case "$command" in
  status) read_endpoint /v1/status ;;
  capabilities) read_endpoint /v1/capabilities ;;
  adapter-status) read_endpoint /v1/adapter/status ;;
  portfolios) read_endpoint /v1/portfolios ;;
  opportunities) read_endpoint /v1/opportunities ;;
  pnl) read_endpoint /v1/pnl ;;
  solana-wallet-flow) read_endpoint /v1/solana-wallet-flow ;;
  pause-entries | pause-all | resume | reconcile)
    require_reason "${2:-}"
    mutate "$command" "/v1/$command" "$2"
    ;;
  flatten)
    test "${3:-}" = '--approve-paper' || {
      printf 'paper flatten requires --approve-paper\n' >&2
      exit 2
    }
    require_reason "${2:-}"
    mutate flatten /v1/emergency-flatten "$2"
    ;;
  paper-reset)
    test "${2:-}" = '--initial-usdc' &&
      test "${4:-}" = '--initial-collateral' &&
      test "${6:-}" = '--approve-paper-reset' &&
      test -z "${7:-}" || {
        usage >&2
        exit 2
      }
    initial_usdc_micros=$(usd_to_micros "${3:-}")
    initial_collateral_usd_micros=$(usd_to_micros "${5:-}")
    approval_expires_at_ms="$(($(date +%s) * 1000 + 60000))"
    body=$(
      jq -cn \
        --arg reason 'operator paper reset' \
        --arg approval 'RESET PAPER' \
        --arg initialUsdcMicros "$initial_usdc_micros" \
        --arg initialCollateralUsdMicros "$initial_collateral_usd_micros" \
        --arg approvalExpiresAtMs "$approval_expires_at_ms" \
        '{
          reason: $reason,
          approval: $approval,
          initialUsdcMicros: $initialUsdcMicros,
          initialCollateralUsdMicros: $initialCollateralUsdMicros,
          approvalExpiresAtMs: $approvalExpiresAtMs
        }'
    )
    signed_post paper-reset /v1/paper/reset "$body"
    ;;
  solana-validation-start | solana-validation-evidence)
    test -n "${2:-}" && test -z "${3:-}" || {
      usage >&2
      exit 2
    }
    request_path=$(absolute_file "$2")
    body=$(jq -c . "$request_path")
    if [ "$command" = 'solana-validation-start' ]; then
      signed_post "$command" /v1/solana-wallet-flow/validation/start "$body"
    else
      signed_post "$command" /v1/solana-wallet-flow/validation/evidence "$body"
    fi
    ;;
  alerts-test)
    require_reason "${2:-}"
    mutate alerts-test /v1/alerts/test "$2"
    ;;
  verify-toolchain)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    exec "$project_dir/scripts/check-toolchain.sh"
    ;;
  solana-read)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    image=$(collector_image)
    docker run --rm \
      --network bridge \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --env "SOLANA_RPC_URL=${SOLANA_RPC_URL:-https://api.mainnet-beta.solana.com}" \
      "$image" solana-read |
      jq .
    ;;
  solana-subscribe)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    image=$(collector_image)
    docker run --rm \
      --network bridge \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --env "SOLANA_WS_URL=${SOLANA_WS_URL:-wss://api.mainnet-beta.solana.com}" \
      "$image" solana-subscribe |
      jq .
    ;;
  solana-inspect-instruction)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    instruction=${SOLANA_INSTRUCTION_JSON:?SOLANA_INSTRUCTION_JSON is required}
    image=$(collector_image)
    docker run --rm \
      --network none \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --env "SOLANA_INSTRUCTION_JSON=$instruction" \
      "$image" solana-inspect-instruction |
      jq .
    ;;
  solana-inspect-jupiter-build)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    build=${JUPITER_BUILD_JSON:?JUPITER_BUILD_JSON is required}
    image=$(collector_image)
    docker run --rm \
      --network none \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --env "JUPITER_BUILD_JSON=$build" \
      "$image" solana-inspect-jupiter-build |
      jq .
    ;;
  solana-transaction-proof)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    image=$(collector_image)
    docker run --rm \
      --network none \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      "$image" solana-transaction-proof |
      jq .
    ;;
  solana-transaction-burst)
    test -z "${2:-}" || {
      usage >&2
      exit 2
    }
    image=$(collector_image)
    docker run --rm \
      --network none \
      --read-only \
      --cap-drop ALL \
      --security-opt no-new-privileges \
      --env "SOLANA_TX_BURST_ITERATIONS=${SOLANA_TX_BURST_ITERATIONS:-1000}" \
      "$image" solana-transaction-burst |
      jq .
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
