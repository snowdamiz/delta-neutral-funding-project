{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:funding-collector:protocol-events:v1",
  "title": "Protocol event v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "source",
    "observedAtMs",
    "sourceSlot",
    "sourceSequence",
    "idempotencyKey",
    "rawPayloadHash",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "MarketSnapshot",
        "FundingSettlement",
        "FundingObservation"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observedAtMs": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "sourceSlot": {
      "$ref": "#/$defs/unsignedInteger"
    },
    "sourceSequence": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "rawPayloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [],
  "additionalProperties": true,
  "$defs": {
    "unsignedInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ratePpm": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5}|1000000)$"
    },
    "signedRatePpm": {
      "type": "string",
      "pattern": "^(0|-?([1-9][0-9]{0,5}|1000000))$"
    },
    "marketSnapshotPayload": {
      "type": "object",
      "required": [
        "epoch",
        "oracleStatus",
        "totalPoolLamports",
        "supplyAtoms",
        "jitosolAtoms",
        "notionalUsdMicros",
        "shortReceiptPpm",
        "solPriceUsdMicros",
        "priorNavLamports",
        "costsUsdMicros",
        "riskHaircutUsdMicros",
        "collateralUsdMicros",
        "maintenanceRequirementUsdMicros",
        "liquidationDistanceBps",
        "solSpotBidPriceUsdMicros",
        "solSpotAskPriceUsdMicros",
        "jitosolSpotBidPriceUsdMicros",
        "jitosolSpotAskPriceUsdMicros",
        "perpBidPriceUsdMicros",
        "perpAskPriceUsdMicros",
        "solExitDepthLamports",
        "jitosolExitDepthLamports",
        "perpExitDepthLamports",
        "fillRatePpm",
        "slippagePpm",
        "spotFeePpm",
        "perpFeePpm",
        "rejectRatePpm",
        "unknownRatePpm"
      ],
      "properties": {
        "epoch": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "oracleStatus": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "totalPoolLamports": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "supplyAtoms": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "jitosolAtoms": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "notionalUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "shortReceiptPpm": {
          "$ref": "#/$defs/signedRatePpm"
        },
        "rewardRatePpmPerHour": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "solPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "priorNavLamports": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "costsUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "riskHaircutUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "collateralUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "maintenanceRequirementUsdMicros": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "liquidationDistanceBps": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "solSpotBidPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "solSpotAskPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "jitosolSpotBidPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "jitosolSpotAskPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpBidPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpAskPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "solExitDepthLamports": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "jitosolExitDepthLamports": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpExitDepthLamports": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "fillRatePpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "slippagePpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "spotFeePpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "perpFeePpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "rejectRatePpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "unknownRatePpm": {
          "$ref": "#/$defs/ratePpm"
        }
      },
      "additionalProperties": true
    },
    "fundingSettlementPayload": {
      "type": "object",
      "required": [
        "venuePaymentId",
        "effectiveAtMs",
        "realizedShortRatePpm",
        "solPriceUsdMicros"
      ],
      "properties": {
        "venuePaymentId": {
          "type": "string",
          "minLength": 1
        },
        "effectiveAtMs": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "realizedShortRatePpm": {
          "$ref": "#/$defs/signedRatePpm"
        },
        "solPriceUsdMicros": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": true
    },
    "fundingObservationPayload": {
      "type": "object",
      "required": [
        "scanId",
        "scanIndex",
        "scanSize",
        "venue",
        "asset",
        "instrument",
        "sourceObservedAtMs",
        "sourceStatus",
        "borrowVenue",
        "borrowMarket",
        "borrowReserve",
        "borrowMint",
        "borrowSourceObservedAtMs",
        "borrowSourceStatus",
        "borrowRatePpmPerHour",
        "borrowAvailableUsdMicros",
        "borrowUtilizationPpm",
        "fundingRatePpmPerHour",
        "fundingHistory",
        "realizedFundingRatePpm",
        "realizedFundingAtMs",
        "markPriceUsdMicros",
        "openInterestUsdMicros",
        "spotBidPriceUsdMicros",
        "spotAskPriceUsdMicros",
        "perpBidPriceUsdMicros",
        "perpAskPriceUsdMicros",
        "spotExitDepthAtoms",
        "perpExitDepthAtoms",
        "depthQualified"
      ],
      "properties": {
        "scanId": {
          "type": "string",
          "minLength": 1
        },
        "scanIndex": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "scanSize": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "venue": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "asset": {
          "type": "string",
          "pattern": "^[A-Z0-9]+$"
        },
        "instrument": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-PERP$"
        },
        "sourceObservedAtMs": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "sourceStatus": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "borrowVenue": {
          "type": "string",
          "minLength": 1
        },
        "borrowMarket": {
          "type": "string",
          "minLength": 1
        },
        "borrowReserve": {
          "type": "string",
          "minLength": 1
        },
        "borrowMint": {
          "type": "string",
          "minLength": 1
        },
        "borrowSourceObservedAtMs": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "borrowSourceStatus": {
          "enum": [
            "valid",
            "invalid",
            "unavailable"
          ]
        },
        "borrowRatePpmPerHour": {
          "$ref": "#/$defs/ratePpm"
        },
        "borrowAvailableUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "borrowUtilizationPpm": {
          "$ref": "#/$defs/ratePpm"
        },
        "fundingRatePpmPerHour": {
          "$ref": "#/$defs/signedRatePpm"
        },
        "fundingHistory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fundingRateSample"
          }
        },
        "realizedFundingRatePpm": {
          "$ref": "#/$defs/signedRatePpm"
        },
        "realizedFundingAtMs": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "markPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "openInterestUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "spotBidPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "spotAskPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpBidPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpAskPriceUsdMicros": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "spotExitDepthAtoms": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "perpExitDepthAtoms": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "depthQualified": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "fundingRateSample": {
      "type": "object",
      "required": [
        "observedAtMs",
        "ratePpm"
      ],
      "properties": {
        "observedAtMs": {
          "$ref": "#/$defs/unsignedInteger"
        },
        "ratePpm": {
          "$ref": "#/$defs/signedRatePpm"
        }
      },
      "additionalProperties": false
    }
  }
}
