{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:funding-collector:protocol-events:v1",
  "title": "Protocol event v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "source",
    "observedAtMs",
    "sourceSlot",
    "sourceSequence",
    "idempotencyKey",
    "rawPayloadHash",
    "payload"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": { "enum": ["MarketSnapshot", "FundingSettlement"] },
    "source": { "type": "string", "minLength": 1 },
    "observedAtMs": { "$ref": "#/$defs/unsignedInteger" },
    "sourceSlot": { "$ref": "#/$defs/unsignedInteger" },
    "sourceSequence": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "rawPayloadHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "eventType": { "const": "MarketSnapshot" },
            "payload": { "$ref": "#/$defs/marketSnapshotPayload" }
          }
        },
        {
          "properties": {
            "eventType": { "const": "FundingSettlement" },
            "payload": { "$ref": "#/$defs/fundingSettlementPayload" }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "unsignedInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "ratePpm": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5}|1000000)$"
    },
    "signedRatePpm": {
      "type": "string",
      "pattern": "^(0|-?([1-9][0-9]{0,5}|1000000))$"
    },
    "marketSnapshotPayload": {
      "type": "object",
      "required": [
        "oracleStatus",
        "totalPoolLamports",
        "supplyAtoms",
        "jitosolAtoms",
        "notionalUsdMicros",
        "shortReceiptPpm",
        "solPriceUsdMicros",
        "priorNavLamports",
        "costsUsdMicros",
        "riskHaircutUsdMicros",
        "collateralUsdMicros",
        "maintenanceRequirementUsdMicros",
        "liquidationDistanceBps",
        "solSpotBidPriceUsdMicros",
        "solSpotAskPriceUsdMicros",
        "jitosolSpotBidPriceUsdMicros",
        "jitosolSpotAskPriceUsdMicros",
        "perpBidPriceUsdMicros",
        "perpAskPriceUsdMicros",
        "solExitDepthLamports",
        "jitosolExitDepthLamports",
        "perpExitDepthLamports",
        "fillRatePpm",
        "slippagePpm",
        "spotFeePpm",
        "perpFeePpm",
        "rejectRatePpm",
        "unknownRatePpm"
      ],
      "properties": {
        "oracleStatus": { "enum": ["valid", "invalid"] },
        "totalPoolLamports": { "$ref": "#/$defs/unsignedInteger" },
        "supplyAtoms": { "$ref": "#/$defs/unsignedInteger" },
        "jitosolAtoms": { "$ref": "#/$defs/unsignedInteger" },
        "notionalUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "shortReceiptPpm": { "$ref": "#/$defs/signedRatePpm" },
        "solPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "priorNavLamports": { "$ref": "#/$defs/unsignedInteger" },
        "costsUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "riskHaircutUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "collateralUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "maintenanceRequirementUsdMicros": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "liquidationDistanceBps": { "$ref": "#/$defs/unsignedInteger" },
        "solSpotBidPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "solSpotAskPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "jitosolSpotBidPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "jitosolSpotAskPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "perpBidPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "perpAskPriceUsdMicros": { "$ref": "#/$defs/unsignedInteger" },
        "solExitDepthLamports": { "$ref": "#/$defs/unsignedInteger" },
        "jitosolExitDepthLamports": { "$ref": "#/$defs/unsignedInteger" },
        "perpExitDepthLamports": { "$ref": "#/$defs/unsignedInteger" },
        "fillRatePpm": { "$ref": "#/$defs/ratePpm" },
        "slippagePpm": { "$ref": "#/$defs/ratePpm" },
        "spotFeePpm": { "$ref": "#/$defs/ratePpm" },
        "perpFeePpm": { "$ref": "#/$defs/ratePpm" },
        "rejectRatePpm": { "$ref": "#/$defs/ratePpm" },
        "unknownRatePpm": { "$ref": "#/$defs/ratePpm" }
      },
      "additionalProperties": true
    },
    "fundingSettlementPayload": {
      "type": "object",
      "required": [
        "venuePaymentId",
        "effectiveAtMs",
        "realizedShortRatePpm",
        "solPriceUsdMicros"
      ],
      "properties": {
        "venuePaymentId": { "type": "string", "minLength": 1 },
        "effectiveAtMs": { "$ref": "#/$defs/unsignedInteger" },
        "realizedShortRatePpm": { "$ref": "#/$defs/signedRatePpm" },
        "solPriceUsdMicros": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "additionalProperties": true
    }
  }
}
